{
  "opencollection": "1.0.0",
  "info": {
    "name": "Financial Modeling Prep Cash Flow Statement API",
    "version": "stable"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cash Flow Statement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get cash flow statements for a company",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://financialmodelingprep.com/stable/cash-flow-statement",
            "params": [
              {
                "name": "symbol",
                "value": "AAPL",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "5",
                "type": "query"
              },
              {
                "name": "period",
                "value": "Q1,Q2,Q3,Q4,FY,annual,quarter",
                "type": "query"
              }
            ]
          },
          "docs": "Get cash flow statements for a company. Documented at https://site.financialmodelingprep.com/developer/docs."
        }
      ]
    }
  ],
  "bundled": true
}