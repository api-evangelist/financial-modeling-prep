{
  "opencollection": "1.0.0",
  "info": {
    "name": "Financial Modeling Prep Quote API",
    "version": "stable"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Quote",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get real-time stock quote",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://financialmodelingprep.com/stable/quote",
            "params": [
              {
                "name": "symbol",
                "value": "AAPL",
                "type": "query"
              }
            ]
          },
          "docs": "Get real-time stock quote. Documented at https://site.financialmodelingprep.com/developer/docs."
        }
      ]
    }
  ],
  "bundled": true
}